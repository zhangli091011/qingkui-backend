APP_ENV=development
DATABASE_URL=sqlite:///./qingkui.db
JWT_SECRET=replace-with-at-least-32-random-characters
ACCESS_TOKEN_MINUTES=30
REFRESH_TOKEN_DAYS=30
INITIAL_CREDITS=1280
CORS_ORIGINS=*
POSTGRES_PASSWORD=replace-with-a-random-database-password
EMAIL_PROVIDER=disabled
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_ADDRESS=
SMTP_STARTTLS=true
MINIO_ROOT_USER=qingkui
MINIO_ROOT_PASSWORD=replace-with-a-random-minio-password
QINGKUI_BIND_ADDRESS=0.0.0.0
QINGKUI_PORT=8000

AI_PROVIDER=deepseek
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_TIMEOUT_SECONDS=45
DEEPSEEK_MAX_TOKENS=4096

# 阿里百炼文档检索。未配置密钥时保持 lexical，问答仍可使用关键词检索。
RETRIEVAL_PROVIDER=lexical
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com
DASHSCOPE_API_MODE=native
DASHSCOPE_EMBEDDING_MODEL=text-embedding-v4
DASHSCOPE_EMBEDDING_DIMENSION=1024
DASHSCOPE_OCR_MODEL=qwen3.5-ocr
DASHSCOPE_RERANK_MODEL=gte-rerank-v2
DASHSCOPE_RERANK_ENABLED=true
DASHSCOPE_TIMEOUT_SECONDS=30
DASHSCOPE_QUERY_TIMEOUT_SECONDS=6
# Semantic subject routing uses the same embedding model; set bailian to enable it.
REINDEX_MAX_WORKERS=4

# Alibaba Cloud OSS. Keep credentials out of source control and CI logs.
OSS_BUCKET=qingkui-yuhua
OSS_ENDPOINT=https://oss-cn-qingdao.aliyuncs.com
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_SOURCE_PREFIX=knowledge/source
OSS_VECTOR_OBJECT_KEY=knowledge/index/qingkui-vectors.npz
OSS_VECTOR_POINTER_KEY=knowledge/index/current.json
QINGKUI_VECTOR_DATA_HOST_PATH=./data
OSS_USER_CONTENT_PREFIX=user-content/mistakes
OSS_SIGNED_URL_SECONDS=300

REDIS_URL=redis://redis:6379/0
RATE_LIMIT_ENABLED=false
RATE_LIMIT_DEFAULT_PER_MINUTE=120
RATE_LIMIT_AUTH_PER_MINUTE=10
RATE_LIMIT_AI_PER_MINUTE=30
RATE_LIMIT_UPLOAD_PER_MINUTE=20
RATE_LIMIT_TRUST_PROXY_HEADERS=false
OPERATIONAL_ALERT_WEBHOOK_URL=
OPERATIONAL_ALERT_WEBHOOK_TIMEOUT_SECONDS=5
OPERATIONAL_ALERT_COOLDOWN_MINUTES=60
OCR_QUEUE_PROVIDER=local
OCR_QUEUE_NAME=qingkui-ocr
OCR_MAX_ATTEMPTS=3
OCR_REVIEW_THRESHOLD=0.85
USER_UPLOAD_MAX_BYTES=10485760
USER_UPLOAD_MAX_PIXELS=20000000
ORGANIZATIONS_ENABLED=false
IDEMPOTENCY_RETENTION_HOURS=24
CREDIT_CAMPAIGNS_ENABLED=false
CONTRIBUTIONS_ENABLED=false
CONTRIBUTION_REWARDS_ENABLED=false
CONTRIBUTION_REWARD_DELAY_HOURS=168
CONTRIBUTION_QUEUE_PROVIDER=local
CONTRIBUTION_QUEUE_NAME=qingkui-contributions
