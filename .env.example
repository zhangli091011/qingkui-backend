APP_ENV=development
DATABASE_URL=sqlite:///./qingkui.db
JWT_SECRET=replace-with-at-least-32-random-characters
ACCESS_TOKEN_MINUTES=30
REFRESH_TOKEN_DAYS=30
INITIAL_CREDITS=1280
CORS_ORIGINS=*
POSTGRES_PASSWORD=replace-with-a-random-database-password
MINIO_ROOT_USER=qingkui
MINIO_ROOT_PASSWORD=replace-with-a-random-minio-password
QINGKUI_BIND_ADDRESS=0.0.0.0
QINGKUI_PORT=8000

AI_PROVIDER=deepseek
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_TIMEOUT_SECONDS=45
