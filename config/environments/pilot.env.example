APP_ENV=pilot
PRIVACY_NOTICE_VERSION=2026-08-31
PRIVACY_CONSENT_ENFORCED=true
DATABASE_URL=postgresql+psycopg://qingkui:${POSTGRES_PASSWORD}@postgres:5432/qingkui_pilot
JWT_SECRET=${JWT_SECRET}
CORS_ORIGINS=https://pilot.invalid
AI_PROVIDER=deepseek
DEEPSEEK_API_KEY=${DEEPSEEK_API_KEY}
RETRIEVAL_PROVIDER=bailian
DASHSCOPE_API_KEY=${DASHSCOPE_API_KEY}
DASHSCOPE_EMBEDDING_MODEL=qwen3.7-text-embedding
OSS_BUCKET=replace-with-private-pilot-bucket
OSS_ENDPOINT=https://oss-cn-qingdao.aliyuncs.com
OSS_ACCESS_KEY_ID=${OSS_ACCESS_KEY_ID}
OSS_ACCESS_KEY_SECRET=${OSS_ACCESS_KEY_SECRET}
QINGKUI_BIND_ADDRESS=127.0.0.1
QINGKUI_PORT=8002
CONTENT_ENFORCE_LAUNCH_SCOPE=true
CONTENT_LAUNCH_SUBJECT=数学
CONTENT_LAUNCH_GRADE=高一
CONTENT_LAUNCH_TEXTBOOK_VERSION=人教A版
RATE_LIMIT_ENABLED=true
ORGANIZATIONS_ENABLED=false
PILOT_AUTHORIZATION_ENFORCED=false
