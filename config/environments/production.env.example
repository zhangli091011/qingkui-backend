APP_ENV=production
DATABASE_URL=postgresql+psycopg://qingkui:${POSTGRES_PASSWORD}@postgres:5432/qingkui
JWT_SECRET=${JWT_SECRET}
CORS_ORIGINS=https://qingkui-api.82-158-229-157.sslip.io
AI_PROVIDER=deepseek
DEEPSEEK_API_KEY=${DEEPSEEK_API_KEY}
RETRIEVAL_PROVIDER=bailian
